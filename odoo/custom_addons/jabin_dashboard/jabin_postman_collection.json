				{
					"name": "Login User (Auto-saves Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && (jsonData.data.token || jsonData.data.access_token)) {",
									"    var token = jsonData.data.token || jsonData.data.access_token;",
									"    pm.environment.set(\"bearer_token\", token);",
									"    pm.collectionVariables.set(\"bearer_token\", token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@jabin.com\",\n  \"password\": \"Secret@1234\"\n}"
						},
