<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default System Parameters for JABIN Loyalty Points System -->
        <record id="param_jabin_loyalty_earning_rate" model="ir.config_parameter">
            <field name="key">jabin_loyalty.earning_rate</field>
            <field name="value">1.0</field>
        </record>

        <record id="param_jabin_loyalty_redemption_rate" model="ir.config_parameter">
            <field name="key">jabin_loyalty.redemption_rate</field>
            <field name="value">100.0</field>
        </record>

        <record id="param_jabin_loyalty_min_redemption" model="ir.config_parameter">
            <field name="key">jabin_loyalty.min_redemption</field>
            <field name="value">500</field>
        </record>
    </data>
</odoo>
