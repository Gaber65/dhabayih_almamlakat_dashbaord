<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ======================================================== -->
        <!--                   1. CATEGORIES                          -->
        <!-- ======================================================== -->
        <record id="cat_sheep_goats" model="jabin.category">
            <field name="name">ذبائح غنم وماعز</field>
            <field name="description">ذبائح الأغنام والماعز البلدية والمستوردة الطازجة بأعلى معايير الجودة والنظافة</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
        </record>

        <record id="cat_camels" model="jabin.category">
            <field name="name">حاشي وإبل</field>
            <field name="description">لحوم حاشي لباني بلدي طازجة ومختارة بعناية فائقة</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
        </record>

        <record id="cat_calves" model="jabin.category">
            <field name="name">عجول وأبقار</field>
            <field name="description">لحوم عجول بلدية طازجة مسمنة بأفضل الأعلاف الطبيعية</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
        </record>

        <record id="cat_cuts_halves" model="jabin.category">
            <field name="name">أجزاء وأنصاف ذبائح</field>
            <field name="description">أنصاف وأرباع الذبائح مجهزة ومقطعة لتناسب احتياجاتكم اليومية</field>
            <field name="sequence">40</field>
            <field name="active">True</field>
        </record>

        <record id="cat_meat_kg" model="jabin.category">
            <field name="name">لحوم ومفروم بالكيلو</field>
            <field name="description">لحوم طازجة يومياً بالعظم وبدون عظم ومفروم فاخر بالكيلو</field>
            <field name="sequence">50</field>
            <field name="active">True</field>
        </record>

        <record id="cat_bbq_boxes" model="jabin.category">
            <field name="name">بوكسات وعروض الشواء</field>
            <field name="description">بوكسات شواء متكاملة ومتبلة ومجهزة للطلعات والجمعات والمناسبات</field>
            <field name="sequence">60</field>
            <field name="active">True</field>
        </record>

        <!-- ======================================================== -->
        <!--                   2. CUTTING OPTIONS                     -->
        <!-- ======================================================== -->
        <record id="cut_fridge" model="jabin.cutting.option">
            <field name="name">تفصيل ثلاجة</field>
            <field name="description">تقطيع قطع صغيرة مع العظم مخصصة للطبخ المنزلي والتفريز</field>
            <field name="active">True</field>
        </record>

        <record id="cut_mufattah" model="jabin.cutting.option">
            <field name="name">تفصيل مفطح</field>
            <field name="description">ذبيحة كاملة مجهزة ومفتوحة على الظهر للولائم والمناسبات والعزائم</field>
            <field name="active">True</field>
        </record>

        <record id="cut_kabsa" model="jabin.cutting.option">
            <field name="name">تقطيع كبسة وإيدام</field>
            <field name="description">قطع متوسطة متناسقة الحجم ومناسبة لكافة أنواع الطبخ والكبسات</field>
            <field name="active">True</field>
        </record>

        <record id="cut_mandi" model="jabin.cutting.option">
            <field name="name">تقطيع مندي ومظبي وحنيذ</field>
            <field name="description">تقطيع أنصاف أو أرباع مفرودة مخصصة للشواء في البراميل وأفران المندي</field>
            <field name="active">True</field>
        </record>

        <record id="cut_quarters" model="jabin.cutting.option">
            <field name="name">تفصيل أرباع</field>
            <field name="description">تقسيم الذبيحة إلى أربعة أرباع متساوية لسهولة الحفظ والتوزيع</field>
            <field name="active">True</field>
        </record>

        <record id="cut_halves" model="jabin.cutting.option">
            <field name="name">تفصيل أنصاف</field>
            <field name="description">تقسيم الذبيحة إلى نصفين متساويين بالطول</field>
            <field name="active">True</field>
        </record>

        <record id="cut_steaks" model="jabin.cutting.option">
            <field name="name">شرائح وستيك</field>
            <field name="description">شرائح لحم وفيليه مقطعة خصيصاً للقلي والشواء السريع</field>
            <field name="active">True</field>
        </record>

        <record id="cut_minced_fine" model="jabin.cutting.option">
            <field name="name">فرم ناعم</field>
            <field name="description">فرم ناعم مخصص للكباب والكفتة والبرجر والحشوات</field>
            <field name="active">True</field>
        </record>

        <record id="cut_minced_coarse" model="jabin.cutting.option">
            <field name="name">فرم خشن</field>
            <field name="description">فرم خشن مخصص للصواني والطبخ والإيدامات</field>
            <field name="active">True</field>
        </record>

        <record id="cut_bbq_skewers" model="jabin.cutting.option">
            <field name="name">تقطيع شواء وأسياخ</field>
            <field name="description">قطع أوصال وشيش مجهزة ومعتنى بها لأسياخ الشوي</field>
            <field name="active">True</field>
        </record>

        <record id="cut_none" model="jabin.cutting.option">
            <field name="name">كاملة بدون تقطيع</field>
            <field name="description">تسليم الذبيحة كاملة وسليمة معلقة دون تقطيع</field>
            <field name="active">True</field>
        </record>

        <!-- ======================================================== -->
        <!--                   3. PACKAGING OPTIONS                   -->
        <!-- ======================================================== -->
        <record id="pkg_vacuum" model="jabin.packaging">
            <field name="name">تغليف سحب هواء (فكيوم)</field>
            <field name="description">تفريغ كامل للهواء للحفاظ على الطزاجة واللون وحماية اللحم من حروق التجميد</field>
            <field name="active">True</field>
        </record>

        <record id="pkg_foam_trays" model="jabin.packaging">
            <field name="name">أطباق فوم مغلفة بسلوفان</field>
            <field name="description">أطباق فوم صحية مرتبة ومحكمة الغلق برول استرتش سلوفان شفاف</field>
            <field name="active">True</field>
        </record>

        <record id="pkg_portion_bags" model="jabin.packaging">
            <field name="name">أكياس تفريز مقسمة بالكيلو</field>
            <field name="description">توزيع وتعبئة اللحم في أكياس سميكة مخصصة للفريزر ومقسمة بوزن 1-2 كجم</field>
            <field name="active">True</field>
        </record>

        <record id="pkg_thermal_box" model="jabin.packaging">
            <field name="name">كرتون حفظ حراري مبرد</field>
            <field name="description">صندوق كرتوني فاخر مبطن بعازل حراري لحفظ البرودة الفائقة أثناء التوصيل</field>
            <field name="active">True</field>
        </record>

        <record id="pkg_banquet" model="jabin.packaging">
            <field name="name">تغليف مناسبات وولائم</field>
            <field name="description">تجهيز الذبيحة على صواني تغليف خاصة للمناسبات والعزائم الفاخرة</field>
            <field name="active">True</field>
        </record>

        <!-- ======================================================== -->
        <!--                   4. EXCLUDED PARTS                      -->
        <!-- ======================================================== -->
        <record id="excl_head" model="jabin.excluded.part">
            <field name="name">بدون رأس</field>
            <field name="description">استبعاد الرأس وعدم إرفاقه مع الذبيحة</field>
            <field name="active">True</field>
        </record>

        <record id="excl_trotters" model="jabin.excluded.part">
            <field name="name">بدون كراعين (مقادم)</field>
            <field name="description">استبعاد الكراعين والمقادم</field>
            <field name="active">True</field>
        </record>

        <record id="excl_viscera" model="jabin.excluded.part">
            <field name="name">بدون أحشاء (كرشة ومصارين)</field>
            <field name="description">استبعاد الكرش والأمعاء والأحشاء الداخلية بالكامل</field>
            <field name="active">True</field>
        </record>

        <record id="excl_fat_tail" model="jabin.excluded.part">
            <field name="name">بدون لية وشحم</field>
            <field name="description">تنظيف الذبيحة واستبعاد اللية والشحم الزائد</field>
            <field name="active">True</field>
        </record>

        <record id="excl_separate_fat" model="jabin.excluded.part">
            <field name="name">فرم الشحم منفصلاً</field>
            <field name="description">عزل الشحم وفرمه وتغليفه في طبق أو كيس مستقل</field>
            <field name="active">True</field>
        </record>

        <record id="excl_isolate_offal" model="jabin.excluded.part">
            <field name="name">عزل الكبدة والقلب والكلاوي</field>
            <field name="description">تنظيف المساليق (كبدة، قلب، كلاوي) وتغليفها بطبق مستقل مبرد</field>
            <field name="active">True</field>
        </record>

        <record id="excl_boneless" model="jabin.excluded.part">
            <field name="name">بدون عظم (لحم مشفى)</field>
            <field name="description">تشفية اللحم وسحب كافة العظام بالكامل</field>
            <field name="active">True</field>
        </record>

