<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================== -->
    <!-- Form View -->
    <!-- ===================== -->
    <record id="view_banner_form" model="ir.ui.view">
        <field name="name">banner.form</field>
        <field name="model">banner</field>
        <field name="arch" type="xml">
            <form string="Banner">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Banner Name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="active"/>
                    </group>

                    <separator string="Banner Image"/>

                    <div class="text-center mb-3">

                        <field name="image"
                               widget="image"
                               nolabel="1"
                               class="oe_avatar"
                               options="{'size':[1200,500]}"/>

                    </div>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ===================== -->
    <!-- Tree View -->
    <!-- ===================== -->
    <record id="view_banner_tree" model="ir.ui.view">
        <field name="name">banner.tree</field>
        <field name="model">banner</field>
        <field name="arch" type="xml">
            <tree>

                <field name="image"
                       widget="image"
                       options="{'size':[180,80]}"/>

                <field name="name"/>

                <field name="active"/>

            </tree>
        </field>
    </record>

    <!-- ===================== -->
    <!-- Search View -->
    <!-- ===================== -->
    <record id="view_banner_search" model="ir.ui.view">
        <field name="name">banner.search</field>
        <field name="model">banner</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"/>

            </search>
        </field>
    </record>

    <!-- ===================== -->
    <!-- Action -->
    <!-- ===================== -->
    <record id="action_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">banner</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_banner_search"/>
    </record>

</odoo>