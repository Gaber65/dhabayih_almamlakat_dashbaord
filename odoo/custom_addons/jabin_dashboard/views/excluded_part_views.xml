<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Excluded Part Tree View -->
    <record id="view_jabin_excluded_part_tree" model="ir.ui.view">
        <field name="name">jabin.excluded.part.tree</field>
        <field name="model">jabin.excluded.part</field>
        <field name="arch" type="xml">
            <tree string="Excluded Parts" decoration-info="active==False">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Excluded Part Form View -->
    <record id="view_jabin_excluded_part_form" model="ir.ui.view">
        <field name="name">jabin.excluded.part.form</field>
        <field name="model">jabin.excluded.part</field>
        <field name="arch" type="xml">
            <form string="Excluded Part">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Excluded Part Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" colspan="2"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Excluded Part Action -->
    <record id="action_jabin_excluded_part" model="ir.actions.act_window">
        <field name="name">Excluded Parts</field>
        <field name="res_model">jabin.excluded.part</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>