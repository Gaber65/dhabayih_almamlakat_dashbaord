<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Packaging Tree View -->
    <record id="view_jabin_packaging_tree" model="ir.ui.view">
        <field name="name">jabin.packaging.tree</field>
        <field name="model">jabin.packaging</field>
        <field name="arch" type="xml">
            <tree string="Packaging Options" decoration-info="active==False">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Packaging Form View -->
    <record id="view_jabin_packaging_form" model="ir.ui.view">
        <field name="name">jabin.packaging.form</field>
        <field name="model">jabin.packaging</field>
        <field name="arch" type="xml">
            <form string="Packaging">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Packaging Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" colspan="2"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Packaging Action -->
    <record id="action_jabin_packaging" model="ir.actions.act_window">
        <field name="name">Packaging Options</field>
        <field name="res_model">jabin.packaging</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>