<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jabin_loyalty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jabin.loyalty</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dhabayih Lmamlaka" string="Dhabayih Lmamlaka" name="jabin_dashboard">
                    <block title="Loyalty Program Settings" name="jabin_loyalty_block">
                        <setting id="loyalty_earning_rate_setting" string="Earning Rate" help="Formula: Earned Points = Order Total (SAR) * Earning Rate (Default: 1 SAR = 1 Point).">
                            <field name="loyalty_earning_rate"/>
                        </setting>
                        <setting id="loyalty_redemption_rate_setting" string="Redemption Rate" help="Formula: Discount (SAR) = Points / Redemption Rate (Default: 100 Points = 1 SAR).">
                            <field name="loyalty_redemption_rate"/>
                        </setting>
                        <setting id="loyalty_min_redemption_setting" string="Minimum Redemption Threshold" help="Minimum loyalty points balance required before a customer can redeem points (Default: 500 Points).">
                            <field name="loyalty_min_redemption"/>
                        </setting>
                    </block>
                    <block title="WhatsApp Support Settings (إعدادات الواتساب)" name="jabin_whatsapp_block">
                        <setting id="whatsapp_enabled_setting" string="Enable WhatsApp" help="Show/hide WhatsApp button across mobile and web apps.">
                            <field name="whatsapp_enabled"/>
                        </setting>
                        <setting id="whatsapp_number_setting" string="WhatsApp Number" help="Customer support WhatsApp phone number with country code (e.g. +966500000000).">
                            <field name="whatsapp_number"/>
                        </setting>
                        <setting id="whatsapp_message_setting" string="Default Message" help="Pre-filled message when starting chat.">
                            <field name="whatsapp_default_message"/>
                        </setting>
                        <setting id="support_phone_setting" string="Unified Phone (الهاتف الموحد)" help="Unified telephone number for customer service and orders.">
                            <field name="support_phone"/>
                        </setting>
                    </block>
                    <block title="إعدادات طباعة الفاتورة والإيصال الحراري (Invoice &amp; Thermal Receipt)" name="jabin_invoice_block">
                        <setting id="invoice_paper_format_setting" string="حجم ورق الفاتورة الافتراضي" help="اختر ما إذا كان التنسيق الافتراضي رول إيصالات حرارية 80مم أو ورقة A4.">
                            <field name="invoice_paper_format"/>
                        </setting>
                        <setting id="invoice_receipt_width_setting" string="عرض الإيصال الحراري (مم)" help="عرض ورق الإيصال بالمليمتر (الافتراضي 80 مم للطابعات الحرارية).">
                            <field name="invoice_receipt_width"/>
                        </setting>
                        <setting id="invoice_show_logo_setting" string="إظهار شعار المتجر" help="إظهار لوجو ذبائح المملكة في أعلى الإيصال والفاتورة.">
                            <field name="invoice_show_logo"/>
                        </setting>
                        <setting id="invoice_show_qr_setting" string="إظهار باركود هيئة الزكاة (ZATCA QR)" help="إظهار رمز الاستجابة السريع للفوترة الإلكترونية.">
                            <field name="invoice_show_qr"/>
                        </setting>
                        <setting id="invoice_header_note_setting" string="ملاحظة الترويسة" help="عبارة تظهر تحت اسم المتجر في الفاتورة.">
                            <field name="invoice_header_note"/>
                        </setting>
                        <setting id="invoice_footer_note_setting" string="ملاحظة التذييل" help="عبارة شكر أو ملاحظات تظهر في أسفل الفاتورة.">
                            <field name="invoice_footer_note"/>
                        </setting>
                    </block>
                    <block title="إعدادات التحقق وبوابة الرسائل (Authentica SMS &amp; Dual Verification)" name="jabin_authentica_block">
                        <setting id="authentica_enable_sms_setting" string="تفعيل التحقق عبر الجوال (SMS)" help="تفعيل تسجيل الدخول وإنشاء الحساب عبر كود التحقق لرقم الجوال السعودي.">
                            <field name="authentica_enable_sms"/>
                        </setting>
                        <setting id="gmail_enable_email_setting" string="تفعيل التحقق عبر الإيميل (Gmail)" help="تفعيل تسجيل الدخول وإنشاء الحساب عبر البريد الإلكتروني.">
                            <field name="gmail_enable_email"/>
                        </setting>
                        <setting id="authentica_api_key_setting" string="Authentica API Key" help="مفتاح الـ X-Authorization المستخرج من لوحة تحكم Authentica (portal.authentica.sa).">
                            <field name="authentica_api_key" password="True"/>
                        </setting>
                        <setting id="authentica_template_id_setting" string="معرف القالب (Template ID)" help="معرف قالب رسالة الـ OTP المعتمد في حسابكم لدى Authentica.">
                            <field name="authentica_template_id"/>
                        </setting>
                        <setting id="authentica_method_setting" string="طريقة الإرسال" help="اختر ما إذا كان الإرسال رسائل SMS نصية أو عبر WhatsApp أو الجمع بينهما.">
                            <field name="authentica_method"/>
                        </setting>
                        <setting id="authentica_sender_id_setting" string="اسم المرسل (Sender ID)" help="اسم المتجر المسجل لدى هيئة الاتصالات والفضاء والتقنية.">
                            <field name="authentica_sender_id"/>
                        </setting>
                        <setting id="authentica_mock_mode_setting" string="وضع التجربة (Mock Sandbox)" help="تفعيل الوضع التجريبي لاختبار التطبيق دون استهلاك رصيد الرسائل الفعلي.">
                            <field name="authentica_mock_mode"/>
                        </setting>
                        <setting id="authentica_balance_setting" string="رصيد الرسائل الحالي" help="فحص الرصيد الفعلي المتبقي في بوابة Authentica فوراً.">
                            <button name="action_check_authentica_balance" type="object" string="🔍 فحص الرصيد المباشر من Authentica" class="btn btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_jabin_loyalty_settings" model="ir.actions.act_window">
        <field name="name">Loyalty &amp; General Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'jabin_dashboard'}</field>
    </record>
</odoo>
