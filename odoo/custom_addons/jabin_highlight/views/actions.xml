<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- jabin.highlight – Window Action                                -->
    <!-- ============================================================ -->

    <!--
        Main action: opens the highlights list with active highlights by default.
        The context includes active_test=False so archived highlights can be
        found through the "Archived" search filter.
    -->
    <record id="action_jabin_highlight" model="ir.actions.act_window">
        <field name="name">Highlights</field>
        <field name="res_model">jabin.highlight</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="view_jabin_highlight_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No highlights found.
            </p>
            <p>
                Highlights are temporary media posts (images or videos) that
                expire automatically after the configured duration.
            </p>
        </field>
    </record>

</odoo>
