<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Scheduled action: cleanup expired highlights.

            Runs every hour.
            Calls: jabin.highlight.service.cleanup_expired_highlights()

            noupdate="1" so administrators can adjust the interval in the
            Odoo backend (Technical → Automation → Scheduled Actions)
            without losing their changes on the next module upgrade.
        -->
        <record id="ir_cron_cleanup_expired_highlights" model="ir.cron">
            <field name="name">JABIN: Cleanup Expired Highlights</field>
            <field name="model_id" ref="model_jabin_highlight_service"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired_highlights()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>