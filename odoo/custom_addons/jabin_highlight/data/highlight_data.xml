<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Default system parameters for the Highlights feature.

            noupdate="1" means these records are only inserted on first install.
            Administrators can change the values in:
                Technical → Parameters → System Parameters
            without those changes being overwritten on module upgrade.
        -->

        <!-- How long a highlight remains visible (hours). Default: 24 -->
        <record id="param_highlight_expiration_hours" model="ir.config_parameter">
            <field name="key">jabin.highlight.expiration_hours</field>
            <field name="value">24</field>
        </record>

        <!-- Maximum size for image uploads (MiB). Default: 10 -->
        <record id="param_highlight_max_image_size_mb" model="ir.config_parameter">
            <field name="key">jabin.highlight.max_image_size_mb</field>
            <field name="value">10</field>
        </record>

        <!-- Maximum size for video uploads (MiB). Default: 100 -->
        <record id="param_highlight_max_video_size_mb" model="ir.config_parameter">
            <field name="key">jabin.highlight.max_video_size_mb</field>
            <field name="value">100</field>
        </record>

        <!-- Maximum allowed video duration (seconds). Default: 30 -->
        <record id="param_highlight_max_video_duration_seconds" model="ir.config_parameter">
            <field name="key">jabin.highlight.max_video_duration_seconds</field>
            <field name="value">30</field>
        </record>

    </data>
</odoo>
