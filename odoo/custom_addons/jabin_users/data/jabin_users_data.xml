<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==================== ORDER NUMBERING SEQUENCE ==================== -->
        <record id="sequence_jabin_order" model="ir.sequence">
            <field name="name">Jabin Order Sequence</field>
            <field name="code">jabin.order</field>
            <field name="prefix">JAB-ORD-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- ==================== DEFAULT PAYMENT METHODS ==================== -->
        <record id="payment_method_cod" model="jabin.payment.method">
            <field name="name">Cash on Delivery</field>
            <field name="code">cod</field>
            <field name="payment_type">cash</field>
            <field name="provider">manual</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_visa" model="jabin.payment.method">
            <field name="name">Visa / Mastercard</field>
            <field name="code">card</field>
            <field name="payment_type">card</field>
            <field name="provider">stripe</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_mada" model="jabin.payment.method">
            <field name="name">Mada</field>
            <field name="code">mada</field>
            <field name="payment_type">card</field>
            <field name="provider">mada</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_stc" model="jabin.payment.method">
            <field name="name">STC Pay</field>
            <field name="code">stc_pay</field>
            <field name="payment_type">wallet</field>
            <field name="provider">stc_pay</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_apple_pay" model="jabin.payment.method">
            <field name="name">Apple Pay</field>
            <field name="code">apple_pay</field>
            <field name="payment_type">wallet</field>
            <field name="provider">myfatoorah</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_myfatoorah" model="jabin.payment.method">
            <field name="name">بوابة ماي فاتورة (مدى / بطاقات إلكترونية)</field>
            <field name="code">myfatoorah</field>
            <field name="payment_type">card</field>
            <field name="provider">myfatoorah</field>
            <field name="is_installment" eval="False"/>
        </record>

        <record id="payment_method_tamara" model="jabin.payment.method">
            <field name="name">Tamara</field>
            <field name="code">tamara</field>
            <field name="payment_type">installment</field>
            <field name="provider">tamara</field>
            <field name="is_installment" eval="True"/>
            <field name="max_installments">4</field>
        </record>

        <record id="payment_method_tabby" model="jabin.payment.method">
            <field name="name">Tabby</field>
            <field name="code">tabby</field>
            <field name="payment_type">installment</field>
            <field name="provider">tabby</field>
            <field name="is_installment" eval="True"/>
            <field name="max_installments">4</field>
        </record>

    </data>
</odoo>